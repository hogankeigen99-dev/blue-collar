DATABASE_URL="postgresql://user:password@localhost:5432/blue_collar"

# Public URL of this app, used to build links in invite/password-reset
# emails. Set to your real domain in production.
APP_URL="http://localhost:3000"

# Resend (https://resend.com) — used to send user-invite and
# password-reset emails. Without it, the app still works: invite links are
# shown on-screen to the inviting admin instead of emailed, and password
# reset links are logged server-side rather than delivered.
RESEND_API_KEY=""
EMAIL_FROM="Blue Collar <onboarding@resend.dev>"

# Cloudflare R2 (S3-compatible) — used for photo/document uploads.
# Generate an API token at: Cloudflare dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="blue-collar-uploads"
